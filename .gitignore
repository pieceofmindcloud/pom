target*
# llama.cpp fork cloned over ssh for the tensor parallelism work
# (path C): its own git repository, it never enters the pom history.
/llama.cpp/
# Anchored at the root on purpose: the macOS filesystem is case-insensitive and
# a loose `logs*` used to swallow web-ui/src/routes/Logs*.tsx without warning. The *.log below
# covers a log file in any folder.
/logs*
# Same trap as the `logs*` above, and it already bit us: a loose `models*` matches
# `crates/node/src/models/`, so every NEW code file there went into the
# .gitignore without warning. A file already tracked stays tracked, which makes the
# defect go unnoticed until someone clones and the build breaks for lack of
# a `mod`. Anchored at the root, it ignores the weights folder and no code.
/models*
/source-models*
venv*
__pycache__*
*.log
.pom.key
# Every variant of the config, not only the exact name: pom-cpu.json and the like
# carry the connection_key, which counts as an operator credential and as an
# API key. A scripted `git add -A` of a deploy script would publish the secret.
pom*.json
# The local SQLite database and the WAL sidecars: operational state and credentials.
/pom.db
/pom.db-wal
/pom.db-shm
.pom-node*.key
.pom-instance.lock
/.pom-dev-plugin-builds/
# local trust chain and the replay ledger next to it (single-node state)
.pom-admin-trust*.json
.pom-model-hashes.json

# macOS Finder junk; it used to enter the repo on its own
.DS_Store

# Build artifacts of the web-ui
web-ui/node_modules/
# Any node_modules, including a symlink (a trailing slash only matches directories).
node_modules
web-ui/dist/
# dist-release is the exception: it is the versioned bundle a release build
# embeds, and cut-ui-bundle.sh is what regenerates it.
!web-ui/dist-release/

# Local packaging: the POM.app that scripts/make-macos-app.sh builds around
# the binary. A build artifact, always reproducible.
/dist-release/
*.tsbuildinfo

/tests/
/web-ui/
/web/

# Content of the Documentation route: generated by apps/frontend/scripts/build-docs.mjs
# during npm build/dev from the repo's AGENTS.md/READMEs. Never commit it - the
# source is the repo; src/docs is only the embedded snapshot.
apps/frontend/src/docs/

# Your machine's Compose: container names and model paths that are not
# valid for anyone else. The versioned docker-compose.yml is not touched.
docker-compose-ksia.yml
dist-release-ksia/
