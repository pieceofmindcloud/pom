# Session migration test: settings. Copy to config.local.env and edit; every step reads it.
# Two POM nodes serve the same model on the same layer split (head A and head B, both layer-0 heads).

# The gateway of each node (the OpenAI-compatible /v1 routes of that node).
GATEWAY_A="${GATEWAY_A:-http://127.0.0.1:8080}"
GATEWAY_B="${GATEWAY_B:-http://127.0.0.1:8081}"
# An active API key (the same one for both nodes, as in the cluster).
API_KEY="${API_KEY:-}"
# The deployed model name as the gateway lists it (/v1/models).
MODEL="${MODEL:-}"
# The node ids of the two heads (as the gateway names them; see GET /api/ui/infer/heads?model=).
NODE_A="${NODE_A:-}"
NODE_B="${NODE_B:-}"

# Where to read the logs of each node. The POM node log (Rust: session pull lines) and the plugin's Strata server
# log (Python bridge: restore lines, <plugin dir>/run/strata-server.log). A path on this machine, or
# "ssh:<host>:<path>" for a file on another machine.
NODE_LOG_A="${NODE_LOG_A:-}"
NODE_LOG_B="${NODE_LOG_B:-}"
SESSION_LOG_A="${SESSION_LOG_A:-}"
SESSION_LOG_B="${SESSION_LOG_B:-}"
# The session folder of each node (<slot_save_path>/strata-sessions), where the saved files appear.
SESSION_DIR_A="${SESSION_DIR_A:-}"
SESSION_DIR_B="${SESSION_DIR_B:-}"

# Conversation name used by every step.
SESSION_KEY="${SESSION_KEY:-migration-test-$(date +%s)}"
# How long to wait for the save of step 1 to reach the disk.
SAVE_WAIT_S="${SAVE_WAIT_S:-60}"
# The result folder of this run (state between steps, logs of each step).
RUN_DIR="${RUN_DIR:-}"   # empty: scripts/session-migration/runs/latest (set by lib.sh)
